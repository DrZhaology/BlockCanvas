{
  "name": "blockcanvas",
  "version": "0.4.5",
  "bcStage": "阶段 5 · 界面与交互全面打磨（测试版）",
  "description": "BlockCanvas 积木画布 - 可视化静态网页构建工具",
  "main": "out/main/main.js",
  "author": "Dr.Zhaology",
  "license": "MIT",
  "private": true,
  "scripts": {
    "version:sync": "node tools/sync-version.mjs",
    "version:check": "node tools/sync-version.mjs --check",
    "git:doctor": "node tools/git-ignore-doctor.mjs",
    "prebuild": "node tools/sync-version.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "pnpm build && node tests/e2e/gui.mjs",
    "test:e2e:fast": "node tests/e2e/gui.mjs --no-shots",
    "test:probe": "node tests/e2e/run-probes.mjs",
    "test:probe:once": "node tests/e2e/run-probes.mjs --no-retry",
    "dev:quiet": "node tools/run-quiet.mjs dev",
    "build:quiet": "node tools/run-quiet.mjs build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "marked": "^18.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  }
}
