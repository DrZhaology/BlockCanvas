  "main": "out/main/main.js",
  "author": "Dr.Zhaology",
  "license": "MIT",
  "private": true,
  "scripts": {
    "version:sync": "node tools/sync-version.mjs",
    "version:check": "node tools/sync-version.mjs --check",
    "prebuild": "node tools/sync-version.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "pnpm build && node tests/e2e/gui.mjs",
    "test:e2e:fast": "node tests/e2e/gui.mjs --no-shots",
    "test:probe": "node tests/e2e/probe-table.mjs && node tests/e2e/probe-v042.mjs"
  },
